# Choose one option. Both Python examples load this file automatically.
# Shared model (used by either option)
GOOGLE_GENAI_MODEL="gemini-3.8-flash"

# Agent Provider ("auto", "azure", or "gemini")
AGENT_PROVIDER="auto"

# Option A1: Azure AI Foundry (OpenAI v1 Responses API)
AZURE_OPENAI_ENDPOINT="https://YOUR_RESOURCE.services.ai.azure.com/openai/v1/responses"
AZURE_OPENAI_API_KEY="PASTE_YOUR_AZURE_OPENAI_API_KEY"
AZURE_OPENAI_MODEL="gpt-5-mini"
AZURE_OPENAI_TIMEOUT_SEC="90.0"
AZURE_OPENAI_ENABLE_WEB_SEARCH="true"
AZURE_OPENAI_REASONING_EFFORT="low"

# Option A2: Gemini Developer API
GEMINI_API_KEY="AQ.Ab8RN6LZCw-"

# Option B: Vertex AI — only needed for the service-account example
GOOGLE_CLOUD_PROJECT="lmu-hackathon-dev-2926"
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/outside/this/repo/key.json"

# Discogs API (required for live lookup calls)
DISCOGS_TOKEN="PASTE_YOUR_DISCOGS_PERSONAL_ACCESS_TOKEN"
DISCOGS_USER_AGENT="LMUTracklistHackathon/1.0"

# Docker Compose PostgreSQL & API
POSTGRES_USER="tracklist"
POSTGRES_PASSWORD="tracklist"
POSTGRES_DB="tracklist"
POSTGRES_PORT="5432"
API_PORT="8000"
NOT_FOUND_TTL_HOURS="24"
MAX_CANDIDATES_TO_FETCH="4"

# External & Gemini Fallback / Worker Queues
ENABLE_MUSICBRAINZ_FALLBACK="true"
ENABLE_DEEZER_FALLBACK="true"
ENABLE_ITUNES_FALLBACK="true"
ENABLE_AGENT_FALLBACK="false"
ENABLE_QUEUE_WORKERS="true"
DISCOGS_QUEUE_CONCURRENCY="1"
AGENT_QUEUE_CONCURRENCY="2"
ENRICH_QUEUE_CONCURRENCY="2"
QUEUE_POLL_INTERVAL_SEC="0.5"

# Track Enrichment & Idle Auto-Sweep
ENABLE_TRACK_ENRICHMENT="true"
ENABLE_AGENT_TRACK_ENRICHMENT="true"
ENABLE_IDLE_AUTO_ENRICHMENT="true"
IDLE_ENRICHMENT_INTERVAL_SEC="15.0"
IDLE_ENRICHMENT_BATCH_SIZE="10"
